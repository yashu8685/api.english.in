{
  "name": "@fluent/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fluent — Hono API, Drizzle schema, auth, spaced repetition and database tooling.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset": "node scripts/reset-db.mjs",
    "db:local": "node scripts/local-db.mjs",
    "db:local:reset": "node scripts/local-db.mjs --reset",
    "smoke:live": "tsx scripts/smoke-live.ts",
    "setup": "npm install && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.7",
    "@neondatabase/serverless": "^1.2.0",
    "better-auth": "^1.7.22",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.6.0-beta.19",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
}
