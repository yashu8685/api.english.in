# ─────────────────────────────────────────────────────────────────────────────
# Fluent — server-side environment
#
# Copy to `.env` and fill in the values:   cp .env.example .env
# This file is read by the API and by drizzle-kit.
# Never commit `.env` — only `.env.example` belongs in git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Neon (production):
#   postgresql://USER:PASSWORD@ep-xxx-xxx.region.aws.neon.tech/fluent?sslmode=require
# Local Docker (docker compose up -d):
#   postgresql://fluent:fluent@localhost:5432/fluent
# No Docker? Run `npm run db:local` in a second terminal — same URL as Docker.
DATABASE_URL=postgresql://fluent:fluent@localhost:5432/fluent

# ── API runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8787

# Generate a secret:  openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-string
# Public URL of this API (used for auth callbacks + cookies)
# Must match the URL the browser uses, exactly — no trailing slash.
BETTER_AUTH_URL=http://localhost:8787
# Origin of the web app (CORS allowlist + trusted auth origin)
# Must match the browser origin exactly — no trailing slash.
WEB_ORIGIN=http://localhost:5173

# ── Testing ──────────────────────────────────────────────────────────────────
# Optional. Defaults to the same server with a separate `fluent_test` database.
# Tests drop and rebuild this schema; never point it at real data.
TEST_DATABASE_URL=postgresql://fluent:fluent@localhost:5432/fluent_test

# ── Optional: AI conversation tutor + audio transcription ────────────────────
# Any OpenAI-compatible endpoint. Leave OPENAI_API_KEY empty to use the
# built-in local coach instead, and to skip automatic transcription (learners
# on Chrome/Edge still get live browser recognition; others type the phrase).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Whisper-compatible model used for recorded speaking attempts.
OPENAI_TRANSCRIBE_MODEL=whisper-1

# ── Optional: phoneme-level pronunciation scoring (Azure Speech) ─────────────
# Without these, attempts are scored by word accuracy. With them, audio is
# assessed phoneme by phoneme in en-GB.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ── Optional: stored recordings ──────────────────────────────────────────────
# Audio is always uploaded for scoring; it is only kept on disk when the
# learner ticks "Save this recording". Files live outside the repo tree and
# are served through an authenticated endpoint. Relative paths resolve from api/.
AUDIO_STORAGE_ENABLED=true
AUDIO_STORAGE_DIR=./.uploads
